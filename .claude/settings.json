{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pr-doc-reminder.mjs",
            "if": "Bash(gh pr create*)",
            "timeout": 10,
            "statusMessage": "Reminding to sync docs for the PR"
          }
        ]
      }
    ]
  }
}
