<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Application -->
    <!-- MediatR 14.x is licensed under a Lucky Penny Software community license.
         The key is supplied via config (MediatR:LicenseKey) and is never committed. -->
    <PackageVersion Include="MediatR" Version="14.1.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Mapster" Version="10.0.8" />
    <!-- MediatR 14's license check resolves ILoggerFactory; AddApplication registers logging. -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.9" />

    <!-- Infrastructure -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- Cloudflare R2 via its S3-compatible API. -->
    <PackageVersion Include="AWSSDK.S3" Version="3.7.405.4" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />

    <!-- Api -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Pin transitive Microsoft.OpenApi past GHSA-v5pm-xwqc-g5wc (stack-overflow DoS parsing circular $ref schemas). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Google ID-token verification for sign-in (GoogleJsonWebSignature). -->
    <PackageVersion Include="Google.Apis.Auth" Version="1.69.0" />
    <!-- Firestore (native mode) durable session + override stores in deployment. -->
    <PackageVersion Include="Google.Cloud.Firestore" Version="3.10.0" />
    <!-- Cloud Storage: read the seed graph from a gs:// object in deployment. -->
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="4.10.0" />

    <!-- DI (needed by test projects that build a ServiceCollection) -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
  </ItemGroup>
</Project>
